# .env.example - Copy to .env and fill in values
# This file documents every environment variable the service needs.

# --- Application ---
NODE_ENV=development   # REQUIRED. One of: development, staging, production
PORT=3000              # REQUIRED. Integer.

# --- Database ---
DATABASE_URL=          # REQUIRED. Full connection string

# --- Authentication ---
JWT_SECRET=            # REQUIRED. Min 32 characters.

# --- Security ---
CORS_ORIGIN=*          # REQUIRED. Allowed origin URL

# --- Logging ---
LOG_LEVEL=info         # OPTIONAL. Default: info.
